{
  "name": "@gouvfr-anct/cartographie-nationale",
  "version": "6.29.3",
  "private": false,
  "repository": {
    "type": "git",
    "url": "https://github.com/anct-cartographie-nationale/cartographie.git"
  },
  "packageManager": "pnpm@12.14.0",
  "type": "module",
  "main": "./dist-wc/cartographie.umd.js",
  "module": "./dist-wc/cartographie.es.js",
  "types": "./dist-wc/web-components/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist-wc/cartographie.es.js",
      "require": "./dist-wc/cartographie.umd.js"
    }
  },
  "files": [
    "dist-wc"
  ],
  "browserslist": [
    "> 1%",
    "maintained node versions",
    "not IE 11",
    "not op_mini all",
    "not dead"
  ],
  "scripts": {
    "dev": "next dev --turbopack",
    "dev:email": "email dev --dir src",
    "dev:wc": "vite --config vite.config.wc.ts",
    "build": "next build",
    "build:wc": "vite build --config vite.config.wc.ts",
    "preview:wc": "vite preview --config vite.config.wc.ts --outDir dist-wc",
    "postbuild": "next-sitemap",
    "test": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:infra": "vitest run --config vitest.config.infra.mjs",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:debug": "playwright test --debug",
    "code:check": "biome check --write && nginx-linter --include 'infrastructure/nginx/*.conf'",
    "biome:ci": "pnpm exec biome ci",
    "lint:architecture": "depcruise src && folderslint",
    "doc:architecture": "depcruise src --include-only \"^src\" --output-type dot | dot -T svg > docs/architecture.svg",
    "lint:commit": "commitlint --from origin/main",
    "prepare": "husky"
  },
  "dependencies": {
    "@arckit/daisyui": "^1.2.2",
    "@arckit/form": "^2.0.1",
    "@arckit/nextjs": "^2.2.2",
    "@arckit/pipeline": "^1.0.0",
    "@arckit/resultset": "^2.1.0",
    "@arckit/telemetry": "^1.5.0",
    "@gouvfr-anct/lieux-de-mediation-numerique": "^4.4.0",
    "@mdx-js/loader": "^3.1.1",
    "@mdx-js/react": "^3.1.1",
    "@next/mdx": "^16.4.3",
    "@r2wc/react-to-web-component": "^2.1.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-popover": "^1.3.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "@sentry/nextjs": "^11.8.0",
    "@tanstack/react-form": "^1.33.5",
    "@tanstack/react-query": "^5.104.4",
    "@tanstack/react-router": "^1.170.45",
    "@tanstack/router-zod-adapter": "^1.81.5",
    "carte-facile": "^0.10.2",
    "clsx": "^2.1.1",
    "daisyui": "^5.7.50",
    "date-fns-tz": "^3.2.0",
    "dotenv": "^18.0.8",
    "downshift": "^9.4.0",
    "effect": "^3.22.1",
    "framer-motion": "^14.3.0",
    "geojson": "^0.5.0",
    "maplibre-gl": "^6.15.0",
    "mutable-supercluster": "^1.1.0",
    "next": "^16.4.3",
    "next-themes": "^0.4.6",
    "nodemailer": "^10.1.6",
    "nuqs": "^2.10.2",
    "opening_hours": "^3.15.0",
    "pino": "^10.4.0",
    "piqure": "2.2.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-email": "^6.11.3",
    "react-hot-toast": "^2.6.1",
    "react-icons": "^5.7.0",
    "react-map-gl": "^8.1.3",
    "rxjs": "^7.8.2",
    "supercluster": "^9.1.0",
    "tailwind-merge": "^3.7.0",
    "tailwindcss-animate": "^1.0.7",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@playwright/test": "^1.64.1",
    "@react-email/ui": "^6.11.3",
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/exec": "^7.1.0",
    "@semantic-release/git": "^11.0.1",
    "@semantic-release/github": "^12.0.10",
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/typography": "^0.5.20",
    "@testing-library/react": "^16.3.3",
    "@types/geojson": "^7946.0.16",
    "@types/mdx": "^2.0.14",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/supercluster": "^7.1.3",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.5",
    "autoprefixer": "^10.6.1",
    "dependency-cruiser": "^18.6.0",
    "folderslint": "^1.2.0",
    "husky": "^9.1.7",
    "jsdom": "^30.1.3",
    "lint-staged": "^17.6.0",
    "next-sitemap": "^4.2.3",
    "nginx-linter": "^0.7.0",
    "postcss": "^8.5.30",
    "semantic-release": "^25.0.9",
    "tailwindcss": "^4.3.3",
    "testcontainers": "^12.2.1",
    "ts-node": "^10.9.2",
    "typescript": "^6.0.3",
    "vite": "^8.3.4",
    "vite-plugin-dts": "^5.1.2",
    "vitest": "^5.0.5"
  }
}
